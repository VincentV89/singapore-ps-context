demo:ev-accessible a demo:Evidence ;
    rdfs:label "Accessible Living Support · fictional rules" ;
    demo:excerpt "Fictional accessibility support: citizen, age 21 or older, accessibility need represented by the synthetic disability flag, and gross monthly household income per person at most S$2,200. Benefit: S$1,200 home adaptation credit. Accessibility and household income evidence are required." ;
    demo:persona "individuals" ;
    demo:source "Synthetic policy catalogue v1 · ALS" ;
    demo:updatedAt "2026-10-08T09:00:00+08:00" .

demo:ev-bridge a demo:Evidence ;
    rdfs:label "Household Bridge Grant · fictional rules" ;
    demo:excerpt "Fictional grant: citizen, age 21 or older, recent job loss, and gross monthly household income per person at most S$1,000. Benefit: S$450 monthly for three months. Income, household composition and employment evidence are required." ;
    demo:persona "individuals" ;
    demo:source "Synthetic policy catalogue v1 · HBG" ;
    demo:updatedAt "2026-10-08T09:00:00+08:00" .

demo:ev-businesses-calculation a demo:Evidence ;
    rdfs:label "Context evaluation and uncertainty" ;
    demo:excerpt "Scheme criteria are conjunctive. A failing criterion excludes a scheme; unknown required facts produce needs review when no criterion fails. Likely eligible is fictional screening, never an approval. Thresholds are evaluated against supplied applicant and project facts without inferred citizenship or household income." ;
    demo:persona "businesses" ;
    demo:source "Demo reasoning specification v2" ;
    demo:updatedAt "2026-10-08T09:00:00+08:00" .

demo:ev-businesses-profile a demo:Evidence ;
    rdfs:label "Synthetic business & project context" ;
    demo:excerpt "Applicant and project facts come from the current editable synthetic profile. The validated request is authoritative; missing facts remain unknown and are never filled from another persona or a default profile." ;
    demo:persona "businesses" ;
    demo:source "Demo businesses scenario v2" ;
    demo:updatedAt "2026-10-08T09:00:00+08:00" .

demo:ev-calculation a demo:Evidence ;
    rdfs:label "Context calculation and uncertainty" ;
    demo:excerpt "Per-person income is gross monthly household income divided by household size. Scheme criteria are conjunctive. A failing criterion excludes a scheme; unknown required facts produce needs review when no criterion fails. Likely eligible is a screening result, never an approval." ;
    demo:persona "individuals" ;
    demo:source "Demo reasoning specification v1" ;
    demo:updatedAt "2026-10-08T09:00:00+08:00" .

