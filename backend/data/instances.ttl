    rdfs:label "Accessibility assessment" ;
    demo:description "Illustrative evidence type; do not upload personal documents to this demo." .

demo:doc-caregiving a demo:Document ;
    rdfs:label "Caregiving declaration" ;
    demo:description "Illustrative evidence type; do not upload personal documents to this demo." .

demo:doc-training a demo:Document ;
    rdfs:label "Training plan" ;
    demo:description "Illustrative evidence type; do not upload personal documents to this demo." .

demo:event-accessibility a demo:LifeEvent ;
    rdfs:label "Accessibility need" ;
    demo:description "Editable synthetic support need." ;
    demo:relatedScheme demo:scheme-accessible .

demo:event-caregiving a demo:LifeEvent ;
    rdfs:label "Caregiving responsibility" ;
    demo:description "Editable synthetic life event." ;
