demo:doc-employment a demo:Document ;
    rdfs:label "Employment transition record" ;
    demo:description "Illustrative evidence type; do not upload personal documents to this demo." .

demo:event-jobloss a demo:LifeEvent ;
    rdfs:label "Recent job loss" ;
    demo:description "Editable synthetic life event." ;
    demo:relatedScheme demo:scheme-bridge,
        demo:scheme-skills .

demo:rule-accessible-1 a demo:EligibilityRule ;
    rdfs:label "Citizen status" ;
    demo:description "Fictional screening criterion." ;
    demo:expected "citizen" ;
    demo:field "citizenship" ;
    demo:operator "eq" ;
    demo:ruleOrder 1 .

demo:rule-accessible-2 a demo:EligibilityRule ;
    rdfs:label "Age 21 or above" ;
    demo:description "Fictional screening criterion." ;
    demo:expected 21 ;
    demo:field "age" ;
    demo:operator "gte" ;
    demo:ruleOrder 2 .

demo:rule-accessible-3 a demo:EligibilityRule ;
    rdfs:label "Accessibility need" ;
    demo:description "Fictional screening criterion." ;
    demo:expected true ;
    demo:field "disability" ;
    demo:operator "eq" ;
    demo:ruleOrder 3 .

demo:rule-accessible-4 a demo:EligibilityRule ;
    rdfs:label "Income per person ≤ S$2,200" ;
    demo:description "Fictional screening criterion." ;
    demo:expected 2200 ;
    demo:field "perCapitaIncome" ;
    demo:operator "lte" ;
    demo:ruleOrder 4 .

