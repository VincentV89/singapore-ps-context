{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private retained deployment artifacts for Singapore public sector context demo",
  "Parameters": {
    "ProjectName": {"Type": "String", "Default": "singapore-ps-context", "AllowedPattern": "[a-z][a-z0-9-]{2,31}"}
  },
  "Resources": {
    "ArtifactsBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {"Fn::Sub": "${ProjectName}-artifacts-${AWS::AccountId}-${AWS::Region}"},
        "BucketEncryption": {"ServerSideEncryptionConfiguration": [{"ServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]},
        "PublicAccessBlockConfiguration": {"BlockPublicAcls": true, "BlockPublicPolicy": true, "IgnorePublicAcls": true, "RestrictPublicBuckets": true},
        "OwnershipControls": {"Rules": [{"ObjectOwnership": "BucketOwnerEnforced"}]},
        "VersioningConfiguration": {"Status": "Enabled"},
        "Tags": [{"Key": "Project", "Value": {"Ref": "ProjectName"}}, {"Key": "Demo", "Value": "synthetic-citizen-services"}]
      }
    },
    "ArtifactsPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {"Ref": "ArtifactsBucket"},
        "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Sid": "RequireTLS", "Effect": "Deny", "Principal": "*", "Action": "s3:*", "Resource": [{"Fn::GetAtt": ["ArtifactsBucket", "Arn"]}, {"Fn::Sub": "${ArtifactsBucket.Arn}/*"}], "Condition": {"Bool": {"aws:SecureTransport": "false"}}}]}
      }
    }
  },
  "Outputs": {"ArtifactsBucket": {"Value": {"Ref": "ArtifactsBucket"}}}
}
