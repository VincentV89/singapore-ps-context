{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Synthetic citizen-services knowledge graph demo: S3/CloudFront, Cognito and scoped HTTP API/Lambda",
  "Parameters": {
    "ProjectName": {"Type": "String", "Default": "singapore-ps-context", "AllowedPattern": "[a-z][a-z0-9-]{2,31}"},
    "LambdaCodeBucket": {"Type": "String"},
    "LambdaCodeKey": {"Type": "String"},
    "FrontendOrigin": {"Type": "String", "Default": "https://deployment.invalid", "AllowedPattern": "https://[a-z0-9.-]+", "Description": "Deploy script updates this to the exact CloudFront origin after initial creation, avoiding a circular dependency."},
    "EnableBedrock": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "BedrockModelId": {"Type": "String", "Default": "amazon.nova-lite-v1:0", "AllowedValues": ["amazon.nova-lite-v1:0"]}
  },
  "Conditions": {"UseBedrock": {"Fn::Equals": [{"Ref": "EnableBedrock"}, "true"]}},
  "Resources": {
    "FrontendBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": {"Fn::Sub": "${ProjectName}-web-${AWS::AccountId}-${AWS::Region}"},
        "BucketEncryption": {"ServerSideEncryptionConfiguration": [{"ServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]},
        "PublicAccessBlockConfiguration": {"BlockPublicAcls": true, "BlockPublicPolicy": true, "IgnorePublicAcls": true, "RestrictPublicBuckets": true},
        "OwnershipControls": {"Rules": [{"ObjectOwnership": "BucketOwnerEnforced"}]},
        "VersioningConfiguration": {"Status": "Enabled"},
        "Tags": [{"Key": "Project", "Value": {"Ref": "ProjectName"}}, {"Key": "Demo", "Value": "synthetic-citizen-services"}]
      }
    },
    "OriginAccessControl": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {"OriginAccessControlConfig": {"Name": {"Fn::Sub": "${ProjectName}-s3"}, "Description": "Signed private S3 origin", "OriginAccessControlOriginType": "s3", "SigningBehavior": "always", "SigningProtocol": "sigv4"}}
    },
    "SpaRoutes": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {"Fn::Sub": "${ProjectName}-routes"},
        "AutoPublish": true,
        "FunctionConfig": {"Comment": "Rewrite extensionless application routes; keep missing assets as errors", "Runtime": "cloudfront-js-2.0"},
        "FunctionCode": "function handler(event) { var r = event.request; var last = r.uri.substring(r.uri.lastIndexOf('/') + 1); if (last.indexOf('.') === -1) r.uri = '/index.html'; return r; }"
      }
    },
    "SecurityHeaders": {
      "Type": "AWS::CloudFront::ResponseHeadersPolicy",
      "Properties": {
        "ResponseHeadersPolicyConfig": {
          "Name": {"Fn::Sub": "${ProjectName}-headers"},
          "Comment": "Exact API origin and regional Cognito endpoints; no external fonts/scripts",
          "SecurityHeadersConfig": {
            "ContentSecurityPolicy": {"Override": true, "ContentSecurityPolicy": {"Fn::Sub": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://${HttpApi}.execute-api.${AWS::Region}.amazonaws.com https://cognito-idp.${AWS::Region}.amazonaws.com https://${ProjectName}-${AWS::AccountId}-${AWS::Region}.auth.${AWS::Region}.amazoncognito.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://${ProjectName}-${AWS::AccountId}-${AWS::Region}.auth.${AWS::Region}.amazoncognito.com; upgrade-insecure-requests"}},
            "ContentTypeOptions": {"Override": true},
            "FrameOptions": {"FrameOption": "DENY", "Override": true},
            "ReferrerPolicy": {"ReferrerPolicy": "no-referrer", "Override": true},
            "StrictTransportSecurity": {"AccessControlMaxAgeSec": 31536000, "IncludeSubdomains": true, "Override": true}
          },
          "CustomHeadersConfig": {"Items": [{"Header": "Permissions-Policy", "Value": "camera=(), microphone=(), geolocation=()", "Override": true}]}
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": {"Fn::Sub": "${ProjectName}: synthetic citizen-services demo"},
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_All",
          "Origins": [{"Id": "private-s3", "DomainName": {"Fn::GetAtt": ["FrontendBucket", "RegionalDomainName"]}, "OriginAccessControlId": {"Ref": "OriginAccessControl"}, "S3OriginConfig": {"OriginAccessIdentity": ""}}],
          "DefaultCacheBehavior": {
            "TargetOriginId": "private-s3", "ViewerProtocolPolicy": "redirect-to-https", "AllowedMethods": ["GET", "HEAD", "OPTIONS"], "CachedMethods": ["GET", "HEAD"], "Compress": true,
            "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad", "ResponseHeadersPolicyId": {"Ref": "SecurityHeaders"},
            "FunctionAssociations": [{"EventType": "viewer-request", "FunctionARN": {"Fn::GetAtt": ["SpaRoutes", "FunctionARN"]}}]
          },
          "CacheBehaviors": [
            {"PathPattern": "config.json", "TargetOriginId": "private-s3", "ViewerProtocolPolicy": "https-only", "AllowedMethods": ["GET", "HEAD", "OPTIONS"], "CachedMethods": ["GET", "HEAD"], "Compress": true, "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad", "ResponseHeadersPolicyId": {"Ref": "SecurityHeaders"}},
            {"PathPattern": "assets/*", "TargetOriginId": "private-s3", "ViewerProtocolPolicy": "https-only", "AllowedMethods": ["GET", "HEAD", "OPTIONS"], "CachedMethods": ["GET", "HEAD"], "Compress": true, "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6", "ResponseHeadersPolicyId": {"Ref": "SecurityHeaders"}}
          ],
          "ViewerCertificate": {"CloudFrontDefaultCertificate": true, "MinimumProtocolVersion": "TLSv1.2_2021"}
        },
        "Tags": [{"Key": "Project", "Value": {"Ref": "ProjectName"}}, {"Key": "Demo", "Value": "synthetic-citizen-services"}]
      }
    },
    "FrontendPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {"Ref": "FrontendBucket"},
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {"Sid": "AllowOnlyThisDistribution", "Effect": "Allow", "Principal": {"Service": "cloudfront.amazonaws.com"}, "Action": "s3:GetObject", "Resource": {"Fn::Sub": "${FrontendBucket.Arn}/*"}, "Condition": {"StringEquals": {"AWS:SourceArn": {"Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"}}}},
            {"Sid": "RequireTLS", "Effect": "Deny", "Principal": "*", "Action": "s3:*", "Resource": [{"Fn::GetAtt": ["FrontendBucket", "Arn"]}, {"Fn::Sub": "${FrontendBucket.Arn}/*"}], "Condition": {"Bool": {"aws:SecureTransport": "false"}}}
          ]
        }
      }
    },
    "UserPool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": {"Fn::Sub": "${ProjectName}-demo"},
        "AdminCreateUserConfig": {"AllowAdminCreateUserOnly": true},
        "UsernameConfiguration": {"CaseSensitive": false},
        "Policies": {"PasswordPolicy": {"MinimumLength": 14, "RequireLowercase": true, "RequireUppercase": true, "RequireNumbers": true, "RequireSymbols": true, "TemporaryPasswordValidityDays": 1}},
        "MfaConfiguration": "OFF",
        "AccountRecoverySetting": {"RecoveryMechanisms": [{"Name": "admin_only", "Priority": 1}]},
        "UserPoolTags": {"Project": {"Ref": "ProjectName"}, "Demo": "synthetic-citizen-services"}
      }
    },
    "ResourceServer": {
      "Type": "AWS::Cognito::UserPoolResourceServer",
      "Properties": {"UserPoolId": {"Ref": "UserPool"}, "Identifier": "life-events", "Name": "Synthetic citizen-services API", "Scopes": [{"ScopeName": "access", "ScopeDescription": "Read synthetic citizen context and evaluate demo scenarios"}]}
    },
    "UserPoolClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "DependsOn": "ResourceServer",
      "Properties": {
        "ClientName": {"Fn::Sub": "${ProjectName}-web"}, "UserPoolId": {"Ref": "UserPool"}, "GenerateSecret": false,
        "AllowedOAuthFlowsUserPoolClient": true, "AllowedOAuthFlows": ["code"], "AllowedOAuthScopes": ["openid", "profile", "life-events/access"], "SupportedIdentityProviders": ["COGNITO"],
        "CallbackURLs": [{"Fn::Sub": "https://${Distribution.DomainName}/auth/callback"}], "LogoutURLs": [{"Fn::Sub": "https://${Distribution.DomainName}/"}],
        "ExplicitAuthFlows": ["ALLOW_USER_SRP_AUTH", "ALLOW_REFRESH_TOKEN_AUTH"],
        "EnableTokenRevocation": true, "PreventUserExistenceErrors": "ENABLED", "AccessTokenValidity": 30, "IdTokenValidity": 30, "RefreshTokenValidity": 1,
        "TokenValidityUnits": {"AccessToken": "minutes", "IdToken": "minutes", "RefreshToken": "days"}
      }
    },
    "UserPoolDomain": {
      "Type": "AWS::Cognito::UserPoolDomain",
      "Properties": {"UserPoolId": {"Ref": "UserPool"}, "Domain": {"Fn::Sub": "${ProjectName}-${AWS::AccountId}-${AWS::Region}"}}
    },
    "FunctionLogs": {
      "Type": "AWS::Logs::LogGroup", "Properties": {"LogGroupName": {"Fn::Sub": "/aws/lambda/${ProjectName}-api"}, "RetentionInDays": 14, "Tags": [{"Key": "Project", "Value": {"Ref": "ProjectName"}}]}
    },
    "FunctionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "lambda.amazonaws.com"}, "Action": "sts:AssumeRole"}]},
        "Policies": [
          {"PolicyName": "OwnLogGroup", "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": {"Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${ProjectName}-api:*"}}]}},
          {"Fn::If": ["UseBedrock", {"PolicyName": "OptionalNovaLite", "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Action": ["bedrock:InvokeModel"], "Resource": [{"Fn::Sub": "arn:${AWS::Partition}:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0"}]}]}}, {"Ref": "AWS::NoValue"}]}
        ],
        "Tags": [{"Key": "Project", "Value": {"Ref": "ProjectName"}}]
      }
    },
    "ApiFunction": {
      "Type": "AWS::Lambda::Function", "DependsOn": "FunctionLogs",
      "Properties": {
        "FunctionName": {"Fn::Sub": "${ProjectName}-api"}, "Runtime": "python3.12", "Architectures": ["x86_64"], "Handler": "app.lambda_handler", "Role": {"Fn::GetAtt": ["FunctionRole", "Arn"]},
        "Code": {"S3Bucket": {"Ref": "LambdaCodeBucket"}, "S3Key": {"Ref": "LambdaCodeKey"}}, "Timeout": 30, "MemorySize": 512, "ReservedConcurrentExecutions": 5,
        "Environment": {"Variables": {"ENABLE_BEDROCK": {"Ref": "EnableBedrock"}, "BEDROCK_MODEL_ID": {"Ref": "BedrockModelId"}}},
        "Tags": [{"Key": "Project", "Value": {"Ref": "ProjectName"}}, {"Key": "Demo", "Value": "synthetic-citizen-services"}]
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {"Fn::Sub": "${ProjectName}-api"}, "ProtocolType": "HTTP", "DisableExecuteApiEndpoint": false,
        "CorsConfiguration": {"AllowOrigins": [{"Ref": "FrontendOrigin"}], "AllowMethods": ["GET", "POST", "OPTIONS"], "AllowHeaders": ["authorization", "content-type"], "MaxAge": 600},
        "Tags": {"Project": {"Ref": "ProjectName"}, "Demo": "synthetic-citizen-services"}
      }
    },
    "JwtAuthorizer": {
      "Type": "AWS::ApiGatewayV2::Authorizer",
      "Properties": {"ApiId": {"Ref": "HttpApi"}, "Name": "CognitoAccessToken", "AuthorizerType": "JWT", "IdentitySource": ["$request.header.Authorization"], "JwtConfiguration": {"Audience": [{"Ref": "UserPoolClient"}], "Issuer": {"Fn::Sub": "https://cognito-idp.${AWS::Region}.amazonaws.com/${UserPool}"}}}
    },
    "LambdaIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration", "Properties": {"ApiId": {"Ref": "HttpApi"}, "IntegrationType": "AWS_PROXY", "IntegrationUri": {"Fn::GetAtt": ["ApiFunction", "Arn"]}, "PayloadFormatVersion": "2.0", "TimeoutInMillis": 30000}
    },
    "ProxyRoute": {
      "Type": "AWS::ApiGatewayV2::Route", "Properties": {"ApiId": {"Ref": "HttpApi"}, "RouteKey": "ANY /{proxy+}", "Target": {"Fn::Join": ["/", ["integrations", {"Ref": "LambdaIntegration"}]]}, "AuthorizationType": "JWT", "AuthorizerId": {"Ref": "JwtAuthorizer"}, "AuthorizationScopes": ["life-events/access"]}
    },
    "RootRoute": {
      "Type": "AWS::ApiGatewayV2::Route", "Properties": {"ApiId": {"Ref": "HttpApi"}, "RouteKey": "ANY /", "Target": {"Fn::Join": ["/", ["integrations", {"Ref": "LambdaIntegration"}]]}, "AuthorizationType": "JWT", "AuthorizerId": {"Ref": "JwtAuthorizer"}, "AuthorizationScopes": ["life-events/access"]}
    },
    "InvokePermission": {
      "Type": "AWS::Lambda::Permission", "Properties": {"Action": "lambda:InvokeFunction", "FunctionName": {"Ref": "ApiFunction"}, "Principal": "apigateway.amazonaws.com", "SourceArn": {"Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*/*"}}
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup", "Properties": {"LogGroupName": {"Fn::Sub": "/aws/apigateway/${ProjectName}"}, "RetentionInDays": 7, "Tags": [{"Key": "Project", "Value": {"Ref": "ProjectName"}}]}
    },
    "DefaultStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {"Ref": "HttpApi"}, "StageName": "$default", "AutoDeploy": true,
        "DefaultRouteSettings": {"ThrottlingBurstLimit": 10, "ThrottlingRateLimit": 5, "DetailedMetricsEnabled": false},
        "AccessLogSettings": {"DestinationArn": {"Fn::GetAtt": ["ApiLogs", "Arn"]}, "Format": "{\"requestId\":\"$context.requestId\",\"httpMethod\":\"$context.httpMethod\",\"routeKey\":\"$context.routeKey\",\"status\":\"$context.status\",\"responseLatency\":\"$context.responseLatency\"}"},
        "Tags": {"Project": {"Ref": "ProjectName"}}
      }
    }
  },
  "Outputs": {
    "WebsiteUrl": {"Value": {"Fn::Sub": "https://${Distribution.DomainName}"}},
    "DistributionId": {"Value": {"Ref": "Distribution"}},
    "FrontendBucket": {"Value": {"Ref": "FrontendBucket"}},
    "ApiUrl": {"Value": {"Fn::GetAtt": ["HttpApi", "ApiEndpoint"]}},
    "UserPoolId": {"Value": {"Ref": "UserPool"}},
    "UserPoolClientId": {"Value": {"Ref": "UserPoolClient"}},
    "CognitoAuthority": {"Value": {"Fn::Sub": "https://cognito-idp.${AWS::Region}.amazonaws.com/${UserPool}"}},
    "CognitoDomain": {"Value": {"Fn::Sub": "https://${ProjectName}-${AWS::AccountId}-${AWS::Region}.auth.${AWS::Region}.amazoncognito.com"}},
    "Region": {"Value": {"Ref": "AWS::Region"}},
    "FunctionName": {"Value": {"Ref": "ApiFunction"}}
  }
}
